<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Alastor.Core\Alastor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>alastor-server</AssemblyName>
    <RootNamespace>Alastor.Server</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Single-file publish: dotnet publish -c Release -r linux-x64 (see docs/building.md) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <WebDir>$(MSBuildThisFileDirectory)..\alastor-web\</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SPA build output is embedded in the assembly and served via ManifestEmbeddedFileProvider. -->
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
    <EmbeddedResource Include="..\..\policy\default.yaml" LogicalName="Alastor.Server.policy.default.yaml" />
    <EmbeddedResource Include="..\..\install\agent-install.sh" LogicalName="Alastor.Server.install.agent-install.sh" Condition="Exists('..\..\install\agent-install.sh')" />
    <EmbeddedResource Include="..\..\install\install.sh" LogicalName="Alastor.Server.install.install.sh" Condition="Exists('..\..\install\install.sh')" />
    <EmbeddedResource Include="..\..\install\alastor.sh" LogicalName="Alastor.Server.install.alastor.sh" Condition="Exists('..\..\install\alastor.sh')" />
  </ItemGroup>

  <!-- Reinstalls node_modules whenever the lockfile is newer than npm's record of the installed tree, so a checkout
       that pulled new dependencies doesn't build against a stale node_modules. -->
  <Target Name="RestoreWeb" Inputs="$(WebDir)package.json;$(WebDir)package-lock.json" Outputs="$(WebDir)node_modules\.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebDir)" />
  </Target>

  <!-- Builds the Svelte SPA into wwwroot before publishing (skip with -p:SkipWebBuild=true). -->
  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreWeb" Condition="'$(Configuration)' == 'Release' AND '$(SkipWebBuild)' != 'true' AND Exists('$(WebDir)package.json')">
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
    <!-- Vite replaces the hashed bundles, so drop the wwwroot items captured at evaluation time and pick up what's there now. -->
    <ItemGroup>
      <EmbeddedResource Remove="@(EmbeddedResource)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('wwwroot'))" />
      <EmbeddedResource Include="wwwroot\**" />
    </ItemGroup>
  </Target>

</Project>
