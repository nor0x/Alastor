<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Sentinel.Core\Sentinel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>sentinel-server</AssemblyName>
    <RootNamespace>Sentinel.Server</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Single-file publish: dotnet publish -c Release -r linux-x64 (see docs/building.md) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <WebDir>$(MSBuildThisFileDirectory)..\sentinel-web\</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SPA build output is embedded in the assembly and served via ManifestEmbeddedFileProvider. -->
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
    <EmbeddedResource Include="..\..\policy\default.yaml" LogicalName="Sentinel.Server.policy.default.yaml" />
    <EmbeddedResource Include="..\..\install\agent-install.sh" LogicalName="Sentinel.Server.install.agent-install.sh" Condition="Exists('..\..\install\agent-install.sh')" />
    <EmbeddedResource Include="..\..\install\install.sh" LogicalName="Sentinel.Server.install.install.sh" Condition="Exists('..\..\install\install.sh')" />
  </ItemGroup>

  <!-- Builds the Svelte SPA into wwwroot before publishing (skip with -p:SkipWebBuild=true). -->
  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' AND '$(SkipWebBuild)' != 'true' AND Exists('$(WebDir)package.json')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
    <ItemGroup>
      <EmbeddedResource Include="wwwroot\**" Exclude="@(EmbeddedResource)" />
    </ItemGroup>
  </Target>

</Project>
