<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <AssemblyName>sentinel-agent</AssemblyName>
    <RootNamespace>Sentinel.Agent</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Publishing (dotnet publish -c Release -r linux-x64 | linux-arm64):
      * Default: Native AOT, one native executable. Measured idle: ~37 MB RSS / ~16 MB private.
        Needs clang + zlib1g-dev on the build machine (and an arm64 toolchain or runner for linux-arm64).
      * -p:AgentAot=false: trimmed, self-contained single-file JIT build. ~54 MB RSS / ~29 MB private.
    -->
    <AgentAot Condition="'$(AgentAot)' == ''">true</AgentAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AgentAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AgentAot)' != 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Compression stays off because it inflates assemblies into RAM at startup. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Server-only code in Sentinel.Core (YAML policy parsing via YamlDotNet) is unreachable from the agent and trimmed away.
         The analyzer still reports it for the whole assembly, so these stay warnings for this project. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL2026;IL3050;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentinel.Core\Sentinel.Core.csproj" />
  </ItemGroup>
</Project>
